# ============================================
# CONFIGURACIÓN OPTIMIZADA PARA RTL-SDR
# ============================================

# SERVIDOR FLASK
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=True
FLASK_ENV=development

PYTHONUNBUFFERED=1
RTL_SDR_DEVICE_INDEX=0


# LOGGING
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10485760  # 10 MB
LOG_BACKUP_COUNT=5

# SDR - SCANNER
# Puntos FFT: 512-1024 (balance velocidad/resolución)
SDR_FFT_POINTS=512
# Promedios: 1-3 (1=rápido, 3=más preciso)
SDR_NUM_AVERAGES=1
# Sample rate: 2.4e6 es estándar para RTL-SDR
SDR_SAMPLE_RATE=2400000
# Timeout para operaciones SDR
SDR_TIMEOUT=10

# CACHE
# Tiempo que se cachea resultado de escaneo (segundos)
CACHE_TIMEOUT=2
# Máximo tamaño del caché
CACHE_MAX_SIZE=100

# WEBSOCKET
# Intervalo de heartbeat (segundos)
WS_HEARTBEAT_INTERVAL=5
# Timeout de inactividad (segundos)
WS_HEARTBEAT_TIMEOUT=15
# Máximo de clientes simultáneos
WS_MAX_CLIENTS=10
# Reintentos de stream antes de fallar
WS_MAX_ERRORS=5

# FRONTEND - DOWNSAMPLING
# Puntos a mostrar en gráficos (256 recomendado)
FRONTEND_DOWNSAMPLE_POINTS=256
# Máximo de filas en waterfall (50 recomendado para balance)
FRONTEND_WATERFALL_MAX_ROWS=50
# Interval de refresco en ms
FRONTEND_REFRESH_INTERVAL=100

# PERFORMANCE
# Thread pool size
THREAD_POOL_SIZE=4
# Request timeout (segundos)
REQUEST_TIMEOUT=5
# Max payload size (MB)
MAX_PAYLOAD_SIZE=50

# DISPOSITIVO
# Usar simulación si no hay hardware (true/false)
SIMULATE_SDR=false
# Ganancia por defecto
DEFAULT_GAIN=auto
# Rango de frecuencias (Hz)
MIN_FREQUENCY=24000000      # 24 MHz
MAX_FREQUENCY=1766000000   # 1766 MHz

# ============================================
# NOTAS DE OPTIMIZACIÓN
# ============================================
# - FLASK_DEBUG=False en producción
# - Aumentar FLASK_PORT si 5000 está ocupado
# - Reducir SDR_FFT_POINTS a 256 si lag severo
# - Aumentar WS_HEARTBEAT_TIMEOUT si conexiones inestables
# - SIMULATE_SDR=true para testing sin hardware
# ============================================